def detect_lang():
    """Follow the Mac's own language, since this ships to strangers' machines."""
    env = (os.environ.get("MACPULSE_LANG") or "").lower()[:2]
    if env in LANGS:
        return env
    try:
        out = subprocess.run(["defaults", "read", "-g", "AppleLocale"],
                             capture_output=True, text=True, timeout=4).stdout
    except Exception:
        return FALLBACK
    code = (out or "").strip().lower()[:2]
    return code if code in LANGS else FALLBACK


