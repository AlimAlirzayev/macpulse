def serve_ui(port, default_lang):
    """Serve the app on loopback only, gated by a token minted at startup.

    This service can terminate processes. A bare localhost port would let any page
    the user happens to have open drive it, so every API call must carry the token,
    and the token only ever reaches the browser through the URL we open ourselves.
    """
    import http.server
    import secrets
    import socket
    import threading
    import urllib.parse

    token = secrets.token_urlsafe(18)
    state = {"findings": [], "seen": time.time()}

    def ui_payload(lang):
        # record=False: the panel rescans on every click and must not flood the history.
        base, found, mem, points, breakdown = _run_scan(lang, record=False)
        state["findings"] = found
        items = []
        for f in found:
            title, detail = rendered(f, lang)
            items.append({"severity": f.sev, "key": f.key, "category": f.category,
                          "title": title, "detail": detail, "cost_kb": f.cost_kb,
                          "core_hours": round(f.core_hours, 1), "fixable": bool(f.fix),
                          "fix_label": f.fix_label(lang), "evidence": f.evidence[:3]})
        # "Recoverable" must mean what pressing Fix would actually give back. Summing
        # every finding's cost inflates it with things we only report — 26 Chrome
        # renderers are 1.5 GB and entirely normal, and counting them would be the
        # same overclaim the disk cleaners make.
        return {"version": VERSION, "lang": lang, "strings": bundle(lang),
                "host": socket.gethostname().replace(".local", ""),
                "score": points, "grade": t(lang, grade_key(points)), "memory": mem,
                "score_breakdown": breakdown, "checks": base["checks"],
                "recoverable_kb": sum(f.cost_kb for f in found if f.fix and f.durable),
                "trend": hist.trend(),      # the panel draws it; a scan alone cannot
                "findings": items}

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *_):            # keep the terminal clean
            pass

        def _query(self):
            return urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)

        def _authorised(self):
            return secrets.compare_digest((self._query().get("k") or [""])[0], token)

        def _lang(self):
            want = (self._query().get("lang") or [""])[0]
            return want if want in LANGS else default_lang

        def _send(self, code, body, ctype="application/json"):
            payload = body.encode() if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)

        def do_GET(self):
            state["seen"] = time.time()
            path = urllib.parse.urlparse(self.path).path
            if path == "/":
                return self._send(200, APP_HTML, "text/html; charset=utf-8")
            if path == "/api/scan":
                if not self._authorised():
                    return self._send(403, '{"error":"bad token"}')
                return self._send(200, json.dumps(ui_payload(self._lang())))
            self._send(404, '{"error":"not found"}')

        def do_POST(self):
            path = urllib.parse.urlparse(self.path).path
            if path not in ("/api/fix", "/api/quit"):
                return self._send(404, '{"error":"not found"}')
            if not self._authorised():
                return self._send(403, '{"error":"bad token"}')
            if path == "/api/quit":
                # Launched from the .app there is no Dock icon and no terminal to
                # Ctrl-C, so the page must be able to stop the server it talks to.
                self._send(200, '{"ok":true}')
                threading.Thread(target=srv.shutdown, daemon=True).start()
                return
            try:
                n = int(self.headers.get("Content-Length", 0))
                key = json.loads(self.rfile.read(n) or b"{}").get("key")
            except (ValueError, TypeError):
                return self._send(400, '{"error":"bad request"}')
            target = next((f for f in state["findings"] if f.key == key and f.fix), None)
            if not target:
                return self._send(404, '{"error":"stale — rescan first"}')
            try:
                return self._send(200, json.dumps({"ok": True, "result": target.fix(self._lang())}))
            except Exception as exc:
                return self._send(200, json.dumps({"ok": False, "error": str(exc)}))

    try:
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError:
        # The app bundle asks for a fixed port so the URL is predictable; if a previous
        # instance still holds it, fall back to any free port rather than not starting.
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)

    if port:
        def reaper():
            while True:
                time.sleep(60)
                if time.time() - state["seen"] > 1800:
                    srv.shutdown()
                    return
        threading.Thread(target=reaper, daemon=True).start()

    url = f"http://127.0.0.1:{srv.server_address[1]}/?k={token}"
    print(f"\n  {S.B}macpulse{S.R} → {S.CYA}{url}{S.R}", flush=True)
    print(f"  {S.D}loopback only · Ctrl-C to quit{S.R}\n", flush=True)
    webbrowser.open(url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()


# ------------------------------------------------------------------- scan as data

def _run_scan(lang, record=True):
    """One full scan -> (payload, findings, mem, points, breakdown)."""
    mem = memory()
    findings = run_checks(processes(), mem)
    breakdown = score_breakdown(findings, mem, lang)
    points = max(0, min(100, 100 - sum(r["points"] for r in breakdown)))
    ages = hist.record(points, mem, findings) if record else {}
    checks = {"run": CHECK_STATUS["run"], "failed": list(CHECK_STATUS["failed"])}
    items = []
    for f in findings:
        title, detail = rendered(f, lang)
        age = ages.get(f.key, {})
        first = age.get("first_seen")
        item = {"severity": f.sev, "key": f.key, "category": f.category,
                "title": title, "detail": detail, "cost_kb": f.cost_kb,
                "core_hours": round(f.core_hours, 1),
                "age_days": round((time.time() - first) / 86400, 2) if first else 0,
                "seen_times": age.get("times", 1),
                "fixable": bool(f.fix), "evidence": f.evidence}
        item.update(f.extra)
        items.append(item)
    payload = {"version": VERSION, "lang": lang, "score": points,
               "grade": t(lang, grade_key(points)), "memory": mem,
               "score_breakdown": breakdown, "checks": checks,
               "strings": bundle(lang), "trend": hist.trend(), "findings": items}
    return payload, findings, mem, points, breakdown


def scan_payload(lang):
    """The exact dict `macpulse --json` prints; also what the MCP server returns."""
    return _run_scan(lang)[0]


def metrics_text(payload):
    """Prometheus text exposition of one scan (also valid OpenMetrics, ends with # EOF)."""
    mem = payload["memory"]
    level = {"normal": 1, "warn": 2, "critical": 4}.get(mem.get("pressure_level"), 0)
    sev = {"critical": 0, "warn": 0, "info": 0}
    for f in payload["findings"]:
        sev[f["severity"]] = sev.get(f["severity"], 0) + 1
    lines = [
        ("macpulse_score", "Mac health score, 0 (struggling) to 100 (healthy).", payload["score"]),
        ("macpulse_swap_used_bytes", "Swap in use, in bytes.",
         int(mem.get("swap_used_mb", 0) * 1048576)),
        ("macpulse_memory_pressure_level",
         "Kernel memory pressure: 1 normal, 2 warn, 4 critical, 0 unknown.", level),
        ("macpulse_disk_free_bytes", "Free space on the data volume, in bytes.",
         int(mem.get("disk_free", 0))),
    ]
    out = []
    for name, helptext, value in lines:
        out += [f"# HELP {name} {helptext}", f"# TYPE {name} gauge", f"{name} {value}"]
    out += ["# HELP macpulse_findings Number of open findings by severity.",
            "# TYPE macpulse_findings gauge"]
    out += [f'macpulse_findings{{severity="{k}"}} {sev[k]}' for k in ("critical", "warn", "info")]
    out.append("# EOF")
    return "\n".join(out) + "\n"


def exit_status(findings, failed=None):
    """Nagios convention: 0 healthy, 1 worst is a warning, 2 critical, 3 unknown.

    3 is returned only when part of the scan could not measure and nothing worse was
    found, so a blind scan is never reported to automation as healthy.
    """
    worst = {f.sev for f in findings}
    if "critical" in worst:
        return 2
    if "warn" in worst:
        return 1
    return 3 if failed else 0


# --------------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--ui", action="store_true", help="open the app window")
    ap.add_argument("--port", type=int, default=0, help="with --ui, a fixed port")
    ap.add_argument("--fix", action="store_true", help="offer to apply each fix")
    ap.add_argument("--yes", "-y", action="store_true", help="with --fix, do not ask")
    ap.add_argument("--report", action="store_true", help="write an HTML report and open it")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--brief", action="store_true",
                    help="one line per warning, nothing when healthy (for AI-assistant hooks)")
    ap.add_argument("--exit-status", action="store_true",
                    help="exit 0 healthy, 1 worst finding is a warning, 2 critical")
    ap.add_argument("--metrics", action="store_true", help="Prometheus text, then exit")
    ap.add_argument("--doctor", action="store_true", help="check macpulse's own installation")
    ap.add_argument("--mcp", action="store_true", help="serve a read-only MCP server on stdio")
    ap.add_argument("--lang", choices=LANGS, help="force a language (default: system)")
    ap.add_argument("--version", action="version", version=f"macpulse {VERSION}")
    args = ap.parse_args()

    if sys.platform != "darwin":
        print("macpulse only runs on macOS.")
        return 2

    lang = args.lang or detect_lang()

    if args.doctor:
        import macpulse_doctor                      # lazy: only this mode needs it
        return macpulse_doctor.run(as_json=args.json, version=VERSION)
    if args.mcp:
        import macpulse_mcp
        return macpulse_mcp.serve(scan_payload, version=VERSION)

    if args.ui:
        serve_ui(args.port, lang)
        return 0

    payload, findings, mem, points, breakdown = _run_scan(lang)
    code = exit_status(findings, payload.get("checks", {}).get("failed")) if args.exit_status else 0

    if args.metrics:
        sys.stdout.write(metrics_text(payload))
        return code

    if args.brief:
        # Read by an AI assistant at the start of every session, so the person does not
        # have to notice the Mac struggling first. Silence means healthy: a hook that
        # always prints something is ignored within a day, like a nagging notification.
        serious = [f for f in findings if f.sev in ("critical", "warn")]
        blind = payload.get("checks", {}).get("failed") or []
        if blind:
            print(f"macpulse: partial scan — could not measure: {', '.join(blind)}")
        if serious:
            print(f"macpulse {points}/100 — Mac needs attention (tell the user, in their language):")
            for f in serious:
                title, detail = rendered(f, "en")
                print(f"- [{f.sev}] {title}. {detail}")
                for e in f.evidence[:5]:
                    print(f"    {e}")
        return code

    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return code

    render_terminal(findings, mem, points, lang, breakdown)
    blind = payload.get("checks", {}).get("failed") or []
    if blind:                             # a partly blind score must say so where it is read
        print(f"  {S.YEL}! partial scan — could not measure: {', '.join(blind)}{S.R}\n")

    if args.report:
        out = report_dir() / "macpulse-report.html"
        render_html(findings, mem, points, out, lang)
        print(f"  {S.CYA}{out}{S.R}\n")
        webbrowser.open(f"file://{out}")

    if args.fix:
        apply_fixes(findings, args.yes, lang)
    return code


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print()
        sys.exit(130)
