  $("#tagline").textContent = T("app.tagline","");
  $("#rescan").textContent = T("btn.rescan","Rescan");
  $("#quit").textContent = T("btn.quit","Quit");
  $("#stamp").textContent = new Date().toLocaleTimeString()+" · "+D.host;

  const counts = {};
  ORDER.forEach(k=>counts[k]=0);
  D.findings.forEach(f=>counts[f.category]=(counts[f.category]||0)+1);
  $("#nav").innerHTML = ORDER.map(k=>`
    <button data-pane="${k}" aria-current="${k===PANE}">
      <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor"
        stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${ICONS[k]}</svg>
      <span class="lbl">${esc(T("nav."+k,k))}</span>
      ${k!=="overview"&&counts[k]?`<span class="cnt">${counts[k]}</span>`:""}
    </button>`).join("");
  document.querySelectorAll("nav button").forEach(b=>
    b.addEventListener("click",()=>{PANE=b.dataset.pane;paint();}));

  $("#langs").innerHTML = ["az","en","ru"].map(l=>
    `<button data-lang="${l}" aria-pressed="${l===D.lang}">${l}</button>`).join("");
  document.querySelectorAll("#langs button").forEach(b=>
    b.addEventListener("click",()=>{LANG=b.dataset.lang;
      localStorage.setItem("macpulse.lang",LANG);scan();}));

  $("#paneTitle").textContent = T("nav."+PANE,PANE);
  const fixable = D.findings.filter(f=>f.fixable);
  $("#fixall").textContent = fixable.length
    ? T("btn.fixall.n","Fix all ({n})").replace("{n}",fixable.length)
    : T("btn.fixall","Fix all safe");
  $("#fixall").disabled = !fixable.length || busy;

  let h = "";
  if(PANE==="overview"){
    const m = D.memory;
    h += `<div class="status">${dial(D.score)}<div class="who">
      <b>${esc(D.grade)}</b><span>${esc(T("ui.readonly",""))}</span></div>${spark(D.trend)}</div>`;
    h += `<p class="grouphead">${esc(T("ui.vitals","Vitals"))}</p><div class="group">`;
    h += [[T("ui.free","Memory free"), m.free_pct+"%"],
          [T("ui.swap","Swap"), (m.swap_used_mb/1024).toFixed(1)+" / "+(m.swap_total_mb/1024).toFixed(1)+" GB"],
          [T("ui.disk","Disk free"), (m.disk_free/1073741824).toFixed(1)+" GB"],
          [T("ui.uptime","Uptime"), Math.round(m.uptime_days)+" "+T("ui.days","days")],
          [T("ui.recoverable","Recoverable"), (D.recoverable_kb/1048576).toFixed(2)+" GB"]]
      .map(([k,v])=>`<div class="row"><div class="txt"><b>${esc(k)}</b></div>
        <span class="val">${esc(v)}</span></div>`).join("");
    h += `</div>`;
    // Count what is on screen, not what exists: the overview lists the findings that
    // need a decision, and a header claiming five while showing three is a small lie
    // in a tool whose entire value is being trusted about numbers.
    const serious = D.findings.filter(f=>f.severity!=="info");
    const top = serious.slice(0,4);
    const rest = D.findings.length - top.length;
    h += `<p class="grouphead">${esc(T("ui.findings","Findings"))} (${top.length})`
       + (rest>0 ? ` <span class="more">+${rest} ${esc(T("ui.insections","in the sections"))}</span>` : "")
       + `</p>`;
    h += top.length ? `<div class="group">${top.map(findingRow).join("")}</div>`
      : `<div class="group"><div class="empty"><b>${esc(T("ui.nofindings",""))}</b>
         ${esc(T("ui.allgood",""))}</div></div>`;
  } else {
    const list = D.findings.filter(f=>f.category===PANE);
    h += list.length ? `<p class="grouphead">${esc(T("ui.findings","Findings"))} (${list.length})</p>
      <div class="group">${list.map(findingRow).join("")}</div>`
      : `<div class="group"><div class="empty">${esc(T("ui.nothing.section",""))}</div></div>`;
  }
  $("#pane").innerHTML = h;
  document.querySelectorAll("button.act").forEach(b=>
    b.addEventListener("click",()=>runFix(b.dataset.key,b)));
}

async function scan(){
  $("#rescan").disabled = true;
  try{
    const q = "/api/scan?k="+encodeURIComponent(TOKEN)+(LANG?"&lang="+LANG:"");
    const r = await fetch(q);
    if(!r.ok) throw new Error(r.status);
    D = await r.json();
    if(!LANG) LANG = D.lang;
    document.documentElement.lang = D.lang;
    paint();
  }catch(e){ toast(T("ui.scanfail","Scan failed: {err}").replace("{err}",e.message)); }
  finally{ $("#rescan").disabled = false; }
}

async function runFix(key,btn){
  if(busy) return;
  busy = true;
  if(btn){btn.disabled=true;btn.textContent=T("btn.working","Working…");}
  try{
    const r = await fetch("/api/fix?k="+encodeURIComponent(TOKEN)+(LANG?"&lang="+LANG:""),
      {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({key})});
    const j = await r.json();
    toast(j.ok ? j.result : T("ui.failed","Could not apply: {err}").replace("{err}",j.error||"?"));
  }catch(e){ toast(T("ui.failed","Could not apply: {err}").replace("{err}",e.message)); }
  finally{ busy=false; await scan(); }
}

