def report_dir():
    """Where --report writes. Never the Desktop: that surface belongs to the person."""
    env = os.environ.get("MACPULSE_REPORT_DIR")
    if env:
        d = pathlib.Path(os.path.expanduser(env))
    else:
        out_dir = HOME / "Documents" / "OS-Output"
        d = out_dir if out_dir.is_dir() else HOME / "Documents" / "macpulse"
    d.mkdir(parents=True, exist_ok=True)
    return d


# ------------------------------------------------------------------------- fixing

def apply_fixes(findings, assume_yes, lang):
    fixable = [f for f in findings if f.fix]
    if not fixable:
        print(f"  {S.GRN}{t(lang, 'ui.nofix')}{S.R}\n")
        return
    done = 0
    for f in fixable:
        print(f"  {S.B}{rendered(f, lang)[0]}{S.R}")
        print(f"    {S.MAG}{f.fix_label(lang)}{S.R}")
        if not assume_yes:
            try:
                ans = input("    [y/N/q] ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                print()
                break
            if ans == "q":
                break
            if ans != "y":
                print(f"    {S.D}—{S.R}\n")
                continue
        try:
            print(f"    {S.GRN}✓ {f.fix(lang)}{S.R}\n")
            done += 1
        except Exception as exc:              # a fix must never crash the run
            print(f"    {S.RED}✗ {exc}{S.R}\n")
    print(f"  {S.B}{t(lang, 'ui.applied', done=done, total=len(fixable))}{S.R}\n")


