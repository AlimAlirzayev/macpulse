# ---------------------------------------------------------------- data collection

class Proc:
    __slots__ = ("pid", "ppid", "cpu", "rss", "elapsed", "cputime", "user", "cmd")

    def __init__(self, pid, ppid, cpu, rss, elapsed, cputime, user, cmd):
        self.pid, self.ppid, self.cpu, self.rss = pid, ppid, cpu, rss
        self.elapsed, self.cputime, self.user, self.cmd = elapsed, cputime, user, cmd

    def resolve_exe(self):
        """Return (path, exists).

        macOS is full of executables whose path contains spaces —
        "/Applications/Google Drive.app/Contents/MacOS/Google Drive" is a single
        argument, not four. Splitting the command line on whitespace therefore
        invents paths like "/Applications/Google" that do not exist, and any check
        built on that will confidently report healthy apps as deleted. So instead of
        guessing where the path ends, walk the tokens and keep the longest prefix
        that is a real file on disk. If no prefix is a file, the binary genuinely is
        gone, and the fallback below reconstructs the path it used to have.
        """
        cmd = self.cmd
        if not cmd.startswith("/"):
            return cmd.split(" ", 1)[0], True     # relative/kernel names: not our business
        tokens = cmd.split(" ")
        acc, best, guess = "", None, []
        for i, tok in enumerate(tokens):
            if tok.startswith("-") and i:         # arguments start here
                break
            acc = tok if not acc else f"{acc} {tok}"
            guess.append(tok)
            if os.path.isfile(acc):
                best = acc
        if best:
            return best, True
        return " ".join(guess), False

    @property
    def exe(self):
        return self.resolve_exe()[0]

    @property
    def short(self):
        e = self.exe
        return e.rsplit("/", 1)[-1] if "/" in e else e[:40]


def _dur(text):
    """Parse ps durations: [[dd-]hh:]mm:ss[.ss] -> seconds."""
    if not text or text in ("-", "?"):
        return 0.0
    days = 0
    if "-" in text:
        d, text = text.split("-", 1)
        days = int(d)
    parts = [float(p) for p in text.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0.0)
    h, m, s = parts
    return days * 86400 + h * 3600 + m * 60 + s


def processes():
    out = subprocess.run(
        ["ps", "-axo", "pid=,ppid=,%cpu=,rss=,etime=,time=,user=,command="],
        capture_output=True, text=True,
    ).stdout
    procs = []
    for line in out.splitlines():
        f = line.split(None, 7)
        if len(f) < 8:
            continue
        try:
            procs.append(Proc(int(f[0]), int(f[1]), float(f[2]), int(f[3]),
                              _dur(f[4]), _dur(f[5]), f[6], f[7]))
        except ValueError:
            continue
    return procs


def descendants(procs, root_pid):
    by_parent = {}
    for p in procs:
        by_parent.setdefault(p.ppid, []).append(p)
    out, stack = [], [root_pid]
    while stack:
        for child in by_parent.get(stack.pop(), []):
            out.append(child)
            stack.append(child.pid)
    return out


def _cmd(args, timeout=8):
    """stdout of a command, or "" when it is missing, slow or fails.

    Every signal below comes from a system command that may be absent (a Mac without a
    battery has no AppleSmartBattery), garbled, or not on PATH. Nothing about a missing
    signal may crash a scan: callers get an empty string and report None.
    """
    try:
        return subprocess.run(args, capture_output=True, text=True,
                              timeout=timeout).stdout or ""
    except (OSError, subprocess.SubprocessError, ValueError):
        return ""


def parse_pressure_level(value):
    """sysctl kern.memorystatus_vm_pressure_level: 1 normal, 2 warn, 4 critical."""
    try:
        return {1: "normal", 2: "warn", 4: "critical"}.get(int(str(value).strip()))
    except (TypeError, ValueError):
        return None


def parse_pmset_therm(text):
    """`pmset -g therm` -> {"speed_limit": int|None, "throttled": bool}.

    CPU_Speed_Limit appears only after macOS has recorded a limit; a Mac that never
    throttled prints "No CPU power status has been recorded" and no number at all.
    """
    m = re.search(r"CPU_Speed_Limit\s*=\s*(\d+)", text or "")
    limit = int(m.group(1)) if m else None
    return {"speed_limit": limit, "throttled": limit is not None and limit < 100}


def _ioreg_int(text, key):
    # Top-level properties are printed one per line as `"Key" = value`; the same keys also
    # appear squeezed inside the BatteryData blob, so the line-anchored form wins.
    m = (re.search(r'^\s*"%s"\s*=\s*(\d+)\s*$' % key, text, re.M)
         or re.search(r'"%s"\s*=\s*(\d+)' % key, text))
    return int(m.group(1)) if m else None


def parse_battery(text):
    """`ioreg -rn AppleSmartBattery` -> {"present","cycle_count","capacity_pct","condition"}.

    On Apple silicon `MaxCapacity` is already a percentage (100), not milliamp-hours, and
    says nothing about wear. Real health is the raw maximum over the design capacity.
    """
    out = {"present": False, "cycle_count": None, "capacity_pct": None, "condition": None}
    text = text or ""
    if not text.strip():
        return out
    cycles = _ioreg_int(text, "CycleCount")
    design = _ioreg_int(text, "DesignCapacity")
    cap = None
    if design:
        for key in ("AppleRawMaxCapacity", "NominalChargeCapacity"):
            raw = _ioreg_int(text, key)
            if raw:
                cap = round(raw / design * 100)
                break
    if cap is None:
        mx = _ioreg_int(text, "MaxCapacity")
        if mx is not None and mx <= 100:
            cap = mx
        elif mx and design:
            cap = round(mx / design * 100)
    if cap is not None:
        cap = max(0, min(100, cap))
    installed = re.search(r'"BatteryInstalled"\s*=\s*(\w+)', text)
    out["present"] = bool((installed and installed.group(1).lower() == "yes")
                          or cycles is not None or cap is not None)
    out["cycle_count"] = cycles
    out["capacity_pct"] = cap
    m = re.search(r'"Condition"\s*=\s*"([^"]+)"', text)
    if m:
        out["condition"] = m.group(1)
    elif out["present"] and cap is not None:
        failed = _ioreg_int(text, "PermanentFailureStatus")
        out["condition"] = ("Permanent failure" if failed
                            else "Service recommended" if cap < 80 else "Normal")
    return out


def _num(text, pattern, default=0.0):
    m = re.search(pattern, text or "")
    try:
        return float(m.group(1)) if m else default
    except ValueError:
        return default


def memory():
    global PAGE
    vm = _cmd(["vm_stat"])
    m = re.search(r"page size of (\d+)", vm)
    if m:
        PAGE = int(m.group(1))
    stat = {}
    for line in vm.splitlines()[1:]:
        if ":" not in line:
            continue
        k, v = line.split(":", 1)
        v = v.strip().rstrip(".")
        if v.isdigit():
            stat[k.strip()] = int(v) * PAGE

    sw = _cmd(["sysctl", "-n", "vm.swapusage"])
    # A sensor that gives no reading must not read as "0 GB swap, all fine": the
    # refuter showed a broken sysctl reported as a healthy Mac. Record it instead.
    blind = [] if "used" in (sw or "") else ["swap (sysctl vm.swapusage)"]
    used = _num(sw, r"used\s*=\s*([\d.]+)M")
    total = _num(sw, r"total\s*=\s*([\d.]+)M")

    total_ram = 0
    try:
        total_ram = int(_cmd(["sysctl", "-n", "hw.memsize"]).strip() or 0)
    except ValueError:
        pass
    if not total_ram:
        try:
            total_ram = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES")
        except (ValueError, OSError, AttributeError):
            total_ram = 0
    free_pct = 0
    mp = _cmd(["memory_pressure"])
    m = re.search(r"free percentage:\s*(\d+)", mp)
    if m:
        free_pct = int(m.group(1))

    boot = _cmd(["sysctl", "-n", "kern.boottime"])
    m = re.search(r"sec\s*=\s*(\d+)", boot)
    uptime_days = (time.time() - int(m.group(1))) / 86400 if m else 0

    # Swap files live on the data volume. Memory and disk are one resource on a Mac:
    # when RAM runs out macOS writes to disk, and when the disk is full too it starts
    # force-quitting apps. Measuring memory without disk headroom misses exactly that.
    try:
        st = os.statvfs("/System/Volumes/Data")
    except OSError:
        st = os.statvfs("/")

    return {
        "total": total_ram,
        "wired": stat.get("Pages wired down", 0),
        "active": stat.get("Pages active", 0),
        "compressed": stat.get("Pages occupied by compressor", 0),
        "swap_used_mb": used,
        "swap_total_mb": total,
        "free_pct": free_pct,
        "uptime_days": uptime_days,
        "disk_free": st.f_bavail * st.f_frsize,
        "disk_total": st.f_blocks * st.f_frsize,
        "sensors_failed": blind,
        # Honest signals (1.4): what the kernel itself says, not what we infer from it.
        "pressure_level": parse_pressure_level(
            _cmd(["sysctl", "-n", "kern.memorystatus_vm_pressure_level"])),
        "thermal": parse_pmset_therm(_cmd(["pmset", "-g", "therm"])),
        "battery": parse_battery(_cmd(["ioreg", "-rn", "AppleSmartBattery"])),
    }


# Large items that are safe to reclaim or regenerate, measured only when the disk is
# actually short — walking them costs a few seconds, which a healthy scan must not pay.
SPACE_HOLDERS = [
    "~/Library/Application Support/Claude/vm_bundles",
    "~/Library/Containers/com.docker.docker/Data/vms",
    "~/.colima/_lima",
    "~/.orbstack/data",
    "~/Library/Application Support/Google/Chrome/OptGuideOnDeviceModel",
    "~/Library/Developer/Xcode/DerivedData",
    "~/Library/Developer/CoreSimulator/Devices",
    "~/.ollama/models",
    "~/.cache/huggingface",
    "~/Library/Caches",
    "~/.Trash",
    "~/Downloads",
]


def space_holders(min_gb=1.0, limit=5, budget_s=8.0):
    """Biggest regenerable items, measured in parallel under one overall time budget.

    This only runs when the disk is short — which is exactly when swap is thrashing and
    every `du` is slow. Measured one after another with per-path timeouts it could take
    minutes and outlive any caller (a 20 s assistant hook, the menu bar scan). Whatever
    has not finished inside the budget is left out rather than waited for.
    """
    jobs = []
    for raw in SPACE_HOLDERS:
        path = os.path.expanduser(raw)
        if os.path.exists(path):
            jobs.append((raw, subprocess.Popen(["du", "-sk", path], stdout=subprocess.PIPE,
                                               stderr=subprocess.DEVNULL, text=True)))
    deadline = time.time() + budget_s
    rows = []
    for raw, proc in jobs:
        try:
            out, _ = proc.communicate(timeout=max(0.05, deadline - time.time()))
            kb = int(out.split(None, 1)[0])
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.communicate()
            continue
        except (ValueError, IndexError):
            continue
        if kb >= min_gb * 1048576:
            rows.append((kb, raw))
    rows.sort(reverse=True)
    return [f"{mb(kb)}  {raw}" for kb, raw in rows[:limit]]


# Safe to delete: caches an app rebuilds, build products, old logs, the Trash. Never
# anything a person or another app would have to recreate by hand — no Downloads, no
# Documents, no container disks, no other app's data directory. `age_days` means only
# entries untouched for that long are eligible, so today's working caches stay.
RECLAIMABLE = [
    ("~/.Trash", 0),
    ("~/Library/Caches", 1),
    ("~/Library/Logs", 30),
    ("~/Library/Developer/Xcode/DerivedData", 0),
    ("~/Library/Developer/CoreSimulator/Caches", 0),
    ("~/Library/Application Support/Google/Chrome/OptGuideOnDeviceModel", 0),
]

# Caches that are cheap to delete and expensive to get back: browser engines a test
# suite downloads, model weights, package archives pulled over a slow link. Reclaiming
# a gigabyte is not worth an hour of re-downloading, so these are left alone.
RECLAIM_EXEMPT = re.compile(
    r"ms-playwright|puppeteer|huggingface|/models?$|\.ollama|Homebrew/downloads", re.I)


def _entry_kb(path):
    try:
        out = subprocess.run(["du", "-sk", path], capture_output=True, text=True,
                             timeout=10).stdout
        return int(out.split(None, 1)[0])
    except (subprocess.TimeoutExpired, ValueError, IndexError):
        return 0


def reclaim_candidates(budget_s=6.0):
    """Top-level entries under RECLAIMABLE that are safe and stale enough to delete."""
    deadline = time.time() + budget_s
    out = []
    for raw, age_days in RECLAIMABLE:
        root = pathlib.Path(os.path.expanduser(raw))
        if not root.is_dir():
            continue
        try:
            entries = sorted(root.iterdir())
        except OSError:
            continue
        cutoff = time.time() - age_days * 86400
        for entry in entries:
            if time.time() > deadline:
                return out
            try:
                if age_days and entry.stat().st_mtime > cutoff:
                    continue
            except OSError:
                continue
            if RECLAIM_EXEMPT.search(str(entry)):
                continue
            kb = _entry_kb(str(entry))
            if kb >= 20 * 1024:                 # ignore anything under 20 MB: not worth it
                out.append((str(entry), kb))
    return out


def _reclaimer(candidates):
    def do(lang):
        freed = 0
        for path, kb in candidates:
            try:
                if os.path.islink(path) or os.path.isfile(path):
                    os.unlink(path)
                else:
                    shutil.rmtree(path, ignore_errors=True)
                    if os.path.exists(path):    # partially removed: count what went
                        kb -= _entry_kb(path)
                freed += max(0, kb)
            except OSError:
                continue
        return t(lang, "res.freed", size=mb(freed))
    return do


def _quitter(app_name, reopen):
    """Quit an app the polite way, and bring it back if it is a browser.

    `quit` through AppleScript is a request, not a kill: the app saves its state and
    asks about unsaved work, and a browser restores its tabs when it comes back — which
    is what makes this safe to offer as a button. SIGKILL would lose work and is never
    used here.
    """
    def do(lang):
        subprocess.run(["osascript", "-e", f'tell application "{app_name}" to quit'],
                       capture_output=True, text=True, timeout=30)
        for _ in range(20):                    # give it up to 10 s to go
            time.sleep(0.5)
            alive = subprocess.run(["pgrep", "-x", app_name[:15]],
                                   capture_output=True, text=True).stdout.strip()
            if not alive:
                break
        if reopen:
            subprocess.run(["open", "-a", app_name], capture_output=True, text=True)
            return t(lang, "res.reopened", name=app_name)
        return t(lang, "res.quit", name=app_name)
    return do


def _own_app_bundles(procs):
    """Bundles this scan is running inside — quitting one would kill the tool itself."""
    by_pid = {p.pid: p for p in procs}
    out, pid, guard = set(), os.getpid(), 0
    while pid in by_pid and guard < 20:
        m = re.search(r"/([^/]+)\.app/", by_pid[pid].cmd)
        if m:
            out.add(m.group(1))
        pid = by_pid[pid].ppid
        guard += 1
    return out


def _top_kb(text):
    m = re.match(r"([\d.]+)([BKMG])", text)
    if not m:
        return 0
    return int(float(m.group(1)) * {"B": 1 / 1024, "K": 1, "M": 1024, "G": 1048576}[m.group(2)])


def app_footprints(procs):
    """Memory per app, summed over all of its processes, in KB.

    `ps` reports resident size, which leaves out compressed and swapped pages — for a
    browser that has been open for days that is most of it. `top` reports the physical
    footprint, the same number the Force Quit window shows: a Chrome that `ps` puts at
    under 2 GB was 10.9 GB there on the day this check was written.
    """
    try:
        out = subprocess.run(["top", "-l", "1", "-o", "mem", "-n", "150", "-stats", "pid,mem"],
                             capture_output=True, text=True, timeout=15).stdout
    except subprocess.TimeoutExpired:
        return {}
    by_pid = {p.pid: p for p in procs}
    apps = {}
    started = False
    for line in out.splitlines():
        cols = line.split()
        if cols[:2] == ["PID", "MEM"]:
            started = True
            continue
        if not started or len(cols) < 2 or not cols[0].isdigit():
            continue
        p = by_pid.get(int(cols[0]))
        if p is None or PROTECTED.search(p.cmd):
            continue
        m = re.search(r"/([^/]+)\.app/", p.cmd)       # outermost bundle owns its helpers
        name = m.group(1) if m else p.short
        apps[name] = apps.get(name, 0) + _top_kb(cols[1])
    return apps


# ---------------------------------------------------------------------- findings

class Finding:
    """A finding stores message *keys* and parameters, never finished sentences.

    The same scan is rendered into a terminal, a JSON blob and a web page, each of
    which may be in a different language, so the text has to be produced at render
    time rather than at detection time.
    """

    def __init__(self, sev, key, category, title_key, detail_key, params,
                 cost_kb=0, core_hours=0.0, fix=None, fix_key=None, fix_params=None,
                 evidence=None, durable=True, extra=None):
        self.sev = sev              # "critical" | "warn" | "info"
        self.key = key
        self.category = category
        self.title_key = title_key
        self.detail_key = detail_key
        self.params = params or {}
        self.cost_kb = cost_kb
        self.core_hours = core_hours
        self.fix = fix              # callable(lang) -> str
        self.fix_key = fix_key
        self.fix_params = fix_params or {}
        self.evidence = evidence or []
        # Does pressing the fix actually leave the machine that much better off? An app
        # that is quit and reopened takes part of its memory straight back, so counting
        # its full footprint as "recoverable" would be the same overclaim this tool was
        # built to argue against. Only durable fixes are added up.
        self.durable = durable
        # Extra machine-readable fields merged into this finding's JSON item (e.g. the
        # per-session list of an AI-toolchain finding). Never rendered as text.
        self.extra = extra or {}

    def title(self, lang):
        return t(lang, self.title_key, **self.params)

    def detail(self, lang):
        return t(lang, self.detail_key, **self.params)

    def fix_label(self, lang):
        return t(lang, self.fix_key, **self.fix_params) if self.fix_key else None


def _age_text(seconds):
    """Compact process age: '3d 4h', '5h 12m', '9m'."""
    s_ = int(max(0, seconds))
    d, h, m = s_ // 86400, (s_ % 86400) // 3600, (s_ % 3600) // 60
    if d:
        return f"{d}d {h}h"
    return f"{h}h {m}m" if h else f"{m}m"


def _killer(pids):
    def do(lang):
        killed = 0
        for pid in pids:
            try:
                os.kill(pid, signal.SIGKILL)
                killed += 1
            except (ProcessLookupError, PermissionError):
                pass
        return t(lang, "res.stopped", done=killed, total=len(pids))
    return do


# --- 1. CPU burners: the check no disk cleaner has -------------------------------

def check_cpu_burners(procs, _mem):
    out = []
    for p in procs:
        if PROTECTED.search(p.cmd) or p.elapsed < 3600:
            continue
        # Sustained load: how much of its lifetime has this process spent on a core?
        load = p.cputime / max(p.elapsed, 1)
        if load < 0.35 and p.cpu < 60:
            continue
        hours = p.cputime / 3600
        if hours < 2:
            continue
        mine = p.user == getpass.getuser()
        out.append(Finding(
            "critical" if (hours > 20 and load > 0.5) else "warn",
            f"cpu:{p.pid}", CAT_PROC, "cpu.t", "cpu.d",
            {"name": p.short, "hours": f"{hours:.0f}", "days": f"{p.elapsed / 86400:.1f}",
             "pct": f"{load * 100:.0f}", "size": mb(p.rss)},
            core_hours=hours,
            fix=_killer([p.pid]) if mine else None,
            fix_key="fix.stop.one" if mine else None, fix_params={"pid": p.pid},
            evidence=[p.cmd[:200]],
        ))
    return sorted(out, key=lambda f: -f.core_hours)[:6]


# --- 2. Ghosts: processes whose binary no longer exists ---------------------------

def check_ghosts(procs, _mem):
    me = getpass.getuser()
    groups = {}
    for p in procs:
        if PROTECTED.search(p.cmd) or p.user != me:
            continue
        # A process younger than a few minutes may simply have been caught mid-update,
        # with its binary swapped out from under it. Only settled processes count.
        if p.elapsed < 300:
            continue
        path, exists = p.resolve_exe()
        if exists or not path.startswith("/"):
            continue
        groups.setdefault(path, []).append(p)

    out = []
    for path, members in sorted(groups.items(), key=lambda kv: -sum(p.rss for p in kv[1])):
        cost = sum(p.rss for p in members)
        hours = sum(p.cputime for p in members) / 3600
        oldest = max(p.elapsed for p in members) / 86400
        params = {
            "name": path.rsplit("/", 1)[-1],
            "where_key": "ghost.where.volume" if path.startswith("/Volumes/") else "ghost.where.app",
            "path": path, "days": f"{oldest:.1f}", "size": mb(cost), "n": len(members),
        }
        out.append(Finding(
            "critical", f"ghost:{path}", CAT_PROC,
            "ghost.t.many" if len(members) > 1 else "ghost.t", "ghost.d", params,
            cost_kb=cost, core_hours=hours,
            fix=_killer([p.pid for p in members]),
            fix_key="fix.stop.many", fix_params={"n": len(members)},
            evidence=[p.cmd[:180] for p in members[:3]],
        ))
    return out[:5]


# --- 3. The AI toolchain audit: the reason this tool exists ------------------------

def _probe_http_mcp(url, timeout=4):
    """Return (key, params) describing an HTTP/SSE MCP endpoint's real state."""
    try:
        r = subprocess.run(
            ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "-m", str(timeout),
             "-X", "POST", "-H", "Content-Type: application/json",
             "-d", '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}', url],
            capture_output=True, text=True, timeout=timeout + 3,
        )
        code = (r.stdout or "").strip()
    except Exception:
        return "mcp.unreachable", {}
    if code in ("401", "403"):
        return "mcp.unauth", {"code": code}
    if code in ("000", ""):
        return "mcp.unreachable", {}
    return None, {}


def check_ai_toolchain(procs, _mem):
    out = []
    me = getpass.getuser()

    # a) One MCP stack per session is the multiplier that surprises people.
    for label, pattern in AI_HOSTS:
        hosts = [p for p in procs
                 if p.user == me and pattern.search(p.cmd) and not PROTECTED.search(p.cmd)]
        if len(hosts) < 2:
            continue
        total, rows, sessions = 0, [], []
        for h in hosts:
            kids = descendants(procs, h.pid)
            mcp = [k for k in kids if MCP_HINT.search(k.cmd)]
            cost = h.rss + sum(k.rss for k in kids)
            total += cost
            rows.append(f"PID {h.pid}: {mb(cost)} ({len(mcp)} MCP) · up {_age_text(h.elapsed)}")
            sessions.append({"pid": h.pid, "mb": round(cost / 1024), "mcp": len(mcp),
                             "age_hours": round(h.elapsed / 3600, 1)})
        sev = "critical" if total > 2 * 1024 * 1024 else ("warn" if len(hosts) > 3 else "info")
        out.append(Finding(
            sev, f"ai:{label}", CAT_AI, "ai.t", "ai.d",
            {"n": len(hosts), "host": label, "size": mb(total), "each": mb(total / len(hosts))},
            cost_kb=total, evidence=rows[:10], extra={"sessions": sessions},
        ))

    # b) A broken MCP server still costs full price, every session.
    cfg = HOME / ".claude.json"
    if cfg.is_file():
        try:
            servers = json.loads(cfg.read_text()).get("mcpServers", {})
        except (ValueError, OSError):
            servers = {}
        sessions = max(1, len([p for p in procs if AI_HOSTS[0][1].search(p.cmd)]))
        for name, spec in servers.items():
            if spec.get("type") in ("http", "sse") and spec.get("url"):
                vkey, vparams = _probe_http_mcp(spec["url"])
                if vkey:
                    out.append(Finding(
                        "warn", f"mcp:{name}", CAT_AI, "mcpdead.t", "mcpdead.d",
                        {"name": name, "n": sessions,
                         "verdict_key": vkey, "verdict_params": vparams},
                        evidence=[spec["url"]],
                    ))
            else:
                token = (spec.get("args") or [None])[-1] or spec.get("command", "")
                if not token:
                    continue
                live = [p for p in procs if token in p.cmd]
                cost = sum(p.rss for p in live)
                if live and cost > 200 * 1024:
                    out.append(Finding(
                        "info", f"mcpcost:{name}", CAT_AI, "mcpcost.t", "mcpcost.d",
                        {"name": name, "size": mb(cost), "n": len(live)},
                        cost_kb=cost,
                    ))
    return out


# --- 4. Headless browser leftovers -------------------------------------------------

def check_headless_browsers(procs, _mem):
    me = getpass.getuser()
    victims = []
    for p in procs:
        if p.user != me or not BROWSER_BIN.search(p.exe):
            continue
        if "--headless" not in p.cmd and "--remote-debugging-port" not in p.cmd:
            continue
        if "--type=" in p.cmd:      # a child renderer, not the leftover root
            continue
        if p.elapsed < 1800:        # a live automation run; leave it alone
            continue
        victims.append(p)
    if not victims:
        return []
    cost = sum(p.rss for p in victims)
    return [Finding(
        "warn", "headless", CAT_BROWSER, "headless.t", "headless.d",
        {"n": len(victims), "size": mb(cost),
         "days": f"{max(v.elapsed for v in victims) / 86400:.1f}"},
        cost_kb=cost, fix=_killer([p.pid for p in victims]),
        fix_key="fix.stop.many", fix_params={"n": len(victims)},
        evidence=[p.cmd[:160] for p in victims[:4]],
    )]


# --- 5. Stale profile locks: the "app will not open" cause -------------------------

def check_stale_locks(procs, _mem):
    live = {p.pid for p in procs}
    out = []
    base = HOME / "Library" / "Application Support"
    try:
        candidates = list(base.glob("*/SingletonLock")) + list(base.glob("*/*/SingletonLock"))
    except OSError:
        return out
    for lock in candidates:
        try:
            target = os.readlink(lock)
        except OSError:
            continue
        m = re.search(r"-(\d+)$", target)
        if not m:
            continue
        pid = int(m.group(1))
        if pid in live:
            continue
        app = lock.parent.name
        siblings = [lock.parent / n for n in ("SingletonLock", "SingletonCookie", "SingletonSocket")]

        def _clear(lang, paths=siblings, name=app):
            n = 0
            for path in paths:
                try:
                    path.unlink()
                    n += 1
                except OSError:
                    pass
            return t(lang, "res.cleared", n=n, app=name)

        out.append(Finding(
            "warn", f"lock:{app}", CAT_BROWSER, "lock.t", "lock.d",
            {"app": app, "pid": pid},
            fix=_clear, fix_key="fix.clearlock", fix_params={"app": app},
            evidence=[str(lock)],
        ))
    return out


# --- 6. Idle heavyweights -----------------------------------------------------------

def check_idle_heavy(procs, _mem):
    out = []
    me = getpass.getuser()
    # Only Docker Desktop itself counts. `com.docker.vmnetd` lives in
    # /Library/PrivilegedHelperTools, is a root launchd service, and runs whether or not
    # Docker Desktop is open — matching on "com.docker" therefore reported Docker as
    # running when it was not, and offered a Quit button that could never do anything,
    # so the finding survived every click. Anything under /Library is not the app.
    docker = [p for p in procs
              if ("/Applications/Docker.app/" in p.cmd or "Docker Desktop.app" in p.cmd)
              and "/Library/PrivilegedHelperTools" not in p.cmd]
    if docker:
        try:
            running = len(subprocess.run(["docker", "ps", "-q"], capture_output=True,
                                         text=True, timeout=8).stdout.split())
        except Exception:
            running = -1
        if running == 0:
            # The Virtualization VM is deliberately not added in: on this Mac one has
            # been up since boot with no relationship to Docker, and blaming it here
            # would inflate the number we ask the user to trust.
            cost = sum(p.rss for p in docker)

            def _quit(lang):
                subprocess.run(["osascript", "-e", 'quit app "Docker Desktop"'],
                               capture_output=True)
                # Quitting is asynchronous. Report what actually happened rather than
                # what was requested — a fix that always claims success is how a button
                # ends up looking broken.
                for _ in range(16):
                    time.sleep(0.5)
                    still = subprocess.run(["pgrep", "-f", "/Applications/Docker.app/"],
                                           capture_output=True, text=True).stdout.split()
                    if not still:
                        return t(lang, "res.dockerquit")
                return t(lang, "res.dockerstuck")

            out.append(Finding(
                "warn", "docker", CAT_CONTAINER, "docker.t", "docker.d",
                {"size": mb(cost)}, cost_kb=cost,
                fix=_quit, fix_key="fix.quitdocker",
            ))

    sims = [p for p in procs if "CoreSimulator" in p.cmd and p.user == me and p.rss > 100 * 1024]
    if sims:
        cost = sum(p.rss for p in sims)
        out.append(Finding("info", "simulator", CAT_CONTAINER, "sim.t", "sim.d",
                           {"n": len(sims), "size": mb(cost)}, cost_kb=cost))
    return out


# --- 7. Memory pressure verdict ------------------------------------------------------

# Thresholds shared with the menu bar sentinel (menubar.m). Change them together.
DISK_CRITICAL_GB, DISK_WARN_GB = 5, 15
SWAP_WARN_RATIO, SWAP_CRITICAL_RATIO = 0.5, 1.0     # swap used, as a share of RAM
HOG_WARN_SHARE, HOG_CRITICAL_SHARE = 0.35, 0.6      # one app's footprint, share of RAM
BROWSER_APP = re.compile(r"Chrome|Safari|Firefox|Arc|Brave|Edge|Opera|Vivaldi|ChatGPT Atlas",
                         re.I)


def check_memory(_procs, mem):
    out = []
    # Swap is judged against RAM, never as a percentage of the swap total: macOS grows
    # the total on demand, so "80% full" can mean 2 GB or 8 GB. v1.2 used the
    # percentage and called this Mac healthy for three days while 8 GB sat in swap.
    ram_mb = mem["total"] / 1048576
    ratio = mem["swap_used_mb"] / ram_mb if ram_mb else 0
    disk_gb = mem.get("disk_free", 0) / GB
    if ratio >= SWAP_WARN_RATIO:
        sev = "critical" if ratio >= SWAP_CRITICAL_RATIO or disk_gb < DISK_WARN_GB else "warn"
        out.append(Finding(
            sev, "swap", CAT_MEMORY, "swap.t", "swap.d",
            {"used": f"{mem['swap_used_mb'] / 1024:.1f}", "ram": f"{mem['total'] / GB:.0f}",
             "days": f"{mem['uptime_days']:.0f}"},
        ))
    if mem["free_pct"] and mem["free_pct"] < 25:
        out.append(Finding("critical", "pressure", CAT_MEMORY, "pressure.t", "pressure.d",
                           {"pct": mem["free_pct"]}))
    elif mem.get("pressure_level") == "critical":
        # The kernel's own verdict. Only raised when the free-percentage rule above did
        # not already fire, so one condition never produces two findings.
        out.append(Finding("critical", "pressure", CAT_MEMORY, "kpressure.t", "kpressure.d", {}))
    if mem["uptime_days"] > 10 and ratio >= SWAP_WARN_RATIO:
        out.append(Finding("info", "uptime", CAT_MEMORY, "uptime.t", "uptime.d",
                           {"days": f"{mem['uptime_days']:.0f}"}))
    return out


def check_disk(_procs, mem):
    """Disk headroom — the half of a memory crisis that memory numbers cannot see."""
    free_gb = mem.get("disk_free", 0) / GB
    if not mem.get("disk_total") or free_gb >= DISK_WARN_GB:
        return []
    candidates = reclaim_candidates()
    reclaimable_kb = sum(kb for _, kb in candidates)
    fix = fix_key = None
    if reclaimable_kb >= 1048576:               # only offer a button worth pressing
        fix, fix_key = _reclaimer(candidates), "disk.fix"
    return [Finding(
        "critical" if free_gb < DISK_CRITICAL_GB else "warn", "disk", CAT_MEMORY,
        "disk.t", "disk.d",
        {"free": f"{free_gb:.1f}", "swap": f"{mem['swap_used_mb'] / 1024:.1f}"},
        cost_kb=reclaimable_kb, fix=fix, fix_key=fix_key,
        fix_params={"size": mb(reclaimable_kb)},
        evidence=space_holders(),
    )]


def check_disk_forecast(_procs, mem):
    """Where the disk is heading, while there is still room to act.

    A threshold only fires once the machine is already in trouble. The free space on a
    working Mac trends, and a machine losing a gigabyte a day has a date with the same
    wall — this says so a week early, which is the only kind of warning that is cheap
    to act on.
    """
    free_gb = mem.get("disk_free", 0) / GB
    if free_gb < DISK_WARN_GB:
        return []                               # already a finding of its own
    trend = hist.disk_slope()
    if not trend:
        return []
    slope, newest, span = trend
    if slope >= -0.2:                           # flat or growing
        return []
    days_left = (newest - DISK_CRITICAL_GB) / -slope
    if days_left > 14:
        return []
    return [Finding("warn", "disk.trend", CAT_MEMORY, "disktrend.t", "disktrend.d",
                    {"rate": f"{-slope:.1f}", "days": f"{days_left:.0f}",
                     "free": f"{newest:.0f}", "span": span})]


def check_app_hogs(procs, mem):
    """One app holding a large share of RAM, measured the way Force Quit measures it."""
    ram_kb = mem["total"] / 1024
    if not ram_kb:
        return []
    own = _own_app_bundles(procs)
    out = []
    for name, kb in sorted(app_footprints(procs).items(), key=lambda kv: -kv[1]):
        share = kb / ram_kb
        if share < HOG_WARN_SHARE:
            break
        browser = bool(BROWSER_APP.search(name))
        # A finding with no button is a complaint. The only ones left without one are
        # the app this scan is running inside (quitting it kills the tool mid-fix) and
        # anything that is not a real .app bundle we can address by name.
        offer = name not in own and os.path.isdir(f"/Applications/{name}.app")
        out.append(Finding(
            "critical" if share >= HOG_CRITICAL_SHARE else "warn", f"hog:{name}", CAT_MEMORY,
            "hog.t", "hog.browser.d" if browser else "hog.d",
            {"name": name, "size": mb(kb), "pct": f"{share * 100:.0f}",
             "ram": f"{mem['total'] / GB:.0f}"},
            cost_kb=int(kb), durable=False,
            fix=_quitter(name, browser) if offer else None,
            fix_key=("hog.fix.reopen" if browser else "hog.fix.quit") if offer else None,
            fix_params={"name": name},
        ))
    return out


# --- 8. Process swarms ----------------------------------------------------------------

def check_swarms(procs, _mem):
    me = getpass.getuser()
    groups = {}
    for p in procs:
        if p.user != me or PROTECTED.search(p.cmd):
            continue
        groups.setdefault(p.exe, []).append(p)
    out = []
    for exe, members in groups.items():
        cost = sum(p.rss for p in members)
        if len(members) < 12 or cost < 700 * 1024:
            continue
        out.append(Finding("info", f"swarm:{exe}", CAT_PROC, "swarm.t", "swarm.d",
                           {"n": len(members), "name": exe.rsplit("/", 1)[-1],
                            "size": mb(cost)}, cost_kb=cost))
    return sorted(out, key=lambda f: -f.cost_kb)[:3]


# --- 9. Thermal throttling and battery wear ---------------------------------------------

def check_thermal(_procs, mem):
    th = mem.get("thermal") or {}
    limit = th.get("speed_limit")
    if limit is None or limit >= 100:
        return []
    return [Finding("warn", "thermal", CAT_PROC, "thermal.t", "thermal.d", {"limit": limit})]


def check_battery(_procs, mem):
    b = mem.get("battery") or {}
    cap = b.get("capacity_pct")
    if not b.get("present") or cap is None or cap >= 80:
        return []
    return [Finding("warn", "battery", CAT_PROC, "battery.t", "battery.d",
                    {"pct": cap, "cycles": b.get("cycle_count") if b.get("cycle_count") is not None else "?"})]


# --- 10. Orphaned MCP servers --------------------------------------------------------

def check_mcp_orphans(procs, _mem):
    """MCP servers re-parented to launchd after their AI session died.

    The hint is matched against the launch command only (first 160 chars): GUI helpers
    such as crashpad handlers carry long argument lists in which "mcp" can appear by
    chance, and app bundles are never MCP servers.

    A dead assistant session can leave its stdio MCP servers running with PPID 1,
    holding memory and serving nothing (Claude Code issue 33947). Only processes of this
    user that have settled for ten minutes count, so a server mid-startup is not flagged.
    """
    me = getpass.getuser()
    mine = [p for p in procs
            if p.user == me and p.ppid == 1 and p.elapsed >= 600 and p.pid != os.getpid()
            and MCP_HINT.search(p.cmd[:160]) and ".app/Contents/" not in p.cmd[:160]
            and not PROTECTED.search(p.cmd) and "macpulse" not in p.cmd[:160]]
    if not mine:
        return []
    cost = sum(p.rss for p in mine)
    return [Finding(
        "warn", "mcp.orphans", CAT_AI, "mcporph.t", "mcporph.d",
        {"n": len(mine), "size": mb(cost)}, cost_kb=cost,
        fix=_killer([p.pid for p in mine]), fix_key="fix.stop.many",
        fix_params={"n": len(mine)},
        evidence=[f"PID {p.pid}: {mb(p.rss)} · {p.cmd[:90]}" for p in mine[:6]],
    )]


CHECKS = [check_cpu_burners, check_ghosts, check_ai_toolchain, check_headless_browsers,
          check_stale_locks, check_idle_heavy, check_memory, check_app_hogs, check_disk, check_disk_forecast,
          check_swarms, check_thermal, check_battery, check_mcp_orphans]


# Coverage of the most recent run_checks(): how many checks ran and which of them raised.
# A check that fails must be visible in the output, not silently dropped.
CHECK_STATUS = {"run": 0, "failed": []}


def run_checks(procs=None, mem=None, apply_mutes=True):
    procs = procs if procs is not None else processes()
    mem = mem if mem is not None else memory()
    found = []
    failed = []
    for check in list(CHECKS):
        try:
            found.extend(check(procs, mem))
        except Exception as exc:          # one bad check must not kill the scan
            failed.append(getattr(check, "__name__", str(check)))
            print(f"{S.D}(check {failed[-1]} failed: {exc}){S.R}", file=sys.stderr)
    if not procs:                         # ps gave nothing: every process check was blind
        failed.append("sensor: process table (ps)")
    failed.extend(f"sensor: {name}" for name in (mem.get("sensors_failed") or []))
    CHECK_STATUS["run"] = len(CHECKS)
    CHECK_STATUS["failed"] = failed
    if apply_mutes:
        silenced = hist.muted_keys()
        found = [f for f in found if f.key not in silenced]
    # Nested message keys (the "where" of a ghost, the "verdict" of an MCP server) are
    # resolved late so they follow the render language like everything else.
    return found


def resolve_nested(f, lang):
    p = dict(f.params)
    if "where_key" in p:
        p["where"] = t(lang, p.pop("where_key"))
    if "verdict_key" in p:
        p["verdict"] = t(lang, p.pop("verdict_key"), **p.pop("verdict_params", {}))
    return p


def rendered(f, lang):
    p = resolve_nested(f, lang)
    return t(lang, f.title_key, **p), t(lang, f.detail_key, **p)


# ------------------------------------------------------------------------- scoring

SEVERITY_POINTS = {"critical": 18, "warn": 8, "info": 0}
MEMORY_FAMILY_CAP = 30      # swap, memory pressure and per-app hogs are ONE root cause


def _memory_family(key):
    return key == "swap" or key.startswith(("pressure", "hog:"))


def score_breakdown(findings, mem, lang="en"):
    """Every deduction behind the score, as [{"key", "reason", "points"}].

    100 - sum(points), clamped to 0..100, is the score. Swap pressure, the kernel's
    pressure verdict and a hungry app are one root cause seen three ways; charging each
    in full made a single bad hour read as three disasters, so together they cost at most
    MEMORY_FAMILY_CAP points. The rest is charged per finding, as before.
    """
    rows, family = [], []
    for f in findings:
        pts = SEVERITY_POINTS.get(f.sev, 0)
        if pts <= 0:
            continue
        (family if _memory_family(f.key) else rows).append((f, pts))
    left = MEMORY_FAMILY_CAP
    for f, pts in sorted(family, key=lambda fp: -fp[1]):     # biggest deduction first
        take = min(pts, left)
        left -= take
        if take > 0:
            rows.append((f, take))
    out = [{"key": f.key, "reason": rendered(f, lang)[0], "points": pts} for f, pts in rows]
    free = mem.get("free_pct")
    if free:
        pts = max(0, (30 - free)) // 2
        if pts:
            out.append({"key": "free_pct", "reason": t(lang, "why.freepct", pct=free),
                        "points": pts})
    out.sort(key=lambda r: -r["points"])
    return out


def score(findings, mem):
    return max(0, min(100, 100 - sum(r["points"] for r in score_breakdown(findings, mem))))


def grade_key(n):
    return "grade.healthy" if n >= 85 else ("grade.attention" if n >= 65 else "grade.struggling")


def grade_colour(n):
    return S.GRN if n >= 85 else (S.YEL if n >= 65 else S.RED)


# ------------------------------------------------------------------- presentation

def _wrap(text, width):
    words, line, out = text.split(), "", []
    for w in words:
        if len(line) + len(w) + 1 > width:
            out.append(line)
            line = w
        else:
            line = f"{line} {w}".strip()
    if line:
        out.append(line)
    return out


def _short(text, width=40):
    """First clause of a finding title, for the one-line score explanation."""
    head = re.split(r",| — | \(|:", text, maxsplit=1)[0].strip()
    return head if len(head) <= width else head[:width - 1].rstrip() + "…"


def render_terminal(findings, mem, points, lang, breakdown=None):
    colour = grade_colour(points)
    bar_w = 34
    filled = round(points / 100 * bar_w)
    print()
    print(f"  {S.B}macpulse{S.R} {S.D}v{VERSION}{S.R}   {S.D}{t(lang, 'app.tagline')}{S.R}")
    print(f"  {hr()}")
    print(f"  {colour}{S.B}{points}/100 — {t(lang, grade_key(points))}{S.R}   "
          f"{colour}{'█' * filled}{S.D}{'░' * (bar_w - filled)}{S.R}")
    print()
    if breakdown:
        top = " · ".join(f"{_short(r['reason'])} −{r['points']}" for r in breakdown[:3])
        for i, line in enumerate(_wrap(t(lang, "why.line", items=top), 74)):
            print(f"  {S.D}{line}{S.R}")
        print()
    print(f"  {S.D}RAM {mem['total'] / GB:.0f} GB · {t(lang, 'ui.free')} {mem['free_pct']}% · "
          f"{t(lang, 'ui.swap')} {mem['swap_used_mb'] / 1024:.1f}/"
          f"{mem['swap_total_mb'] / 1024:.1f} GB · "
          f"{t(lang, 'ui.disk')} {mem['disk_free'] / GB:.0f} GB · "
          f"{t(lang, 'ui.uptime')} {mem['uptime_days']:.0f} {t(lang, 'ui.days')}{S.R}")
    print()

    if not findings:
        print(f"  {S.GRN}{t(lang, 'ui.allgood')}{S.R}\n")
        return

    # Only what pressing Fix would really free — same rule as the app.
    reclaim = sum(f.cost_kb for f in findings if f.fix and f.durable)
    hours = sum(f.core_hours for f in findings)
    head = []
    if reclaim:
        head.append(f"{S.B}{mb(reclaim)}{S.R} {t(lang, 'ui.recoverable').lower()}")
    if hours >= 1:
        head.append(f"{S.B}{t(lang, 'ui.corehours', n=f'{hours:.0f}')}{S.R}")
    if head:
        print(f"  {' · '.join(head)}\n")

    icons = {"critical": (S.RED, "●"), "warn": (S.YEL, "●"), "info": (S.CYA, "○")}
    for order in ("critical", "warn", "info"):
        for f in [x for x in findings if x.sev == order]:
            c, dot = icons[f.sev]
            title, detail = rendered(f, lang)
            print(f"  {c}{dot}{S.R} {S.B}{title}{S.R}")
            for line in _wrap(detail, 72):
                print(f"    {S.D}{line}{S.R}")
            for e in f.evidence[:4]:
                print(f"    {S.D}· {e[:70]}{S.R}")
            if f.fix:
                print(f"    {S.MAG}→ {f.fix_label(lang)}{S.R}")
            print()

    fixable = [f for f in findings if f.fix]
    if fixable:
        print(f"  {hr()}")
        print(f"  {S.B}{len(fixable)}/{len(findings)}{S.R} → macpulse --fix\n")


